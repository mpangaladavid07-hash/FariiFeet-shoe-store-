# ---------------------------------------------------------------------------
# FariiFeet — environment variables
#
# Copy this file to `.env` (git-ignored) and fill in your own values. Vite only
# exposes variables prefixed with VITE_; everything else stays on the server
# (the Netlify functions and the `npm run instagram:sync` script).
#
# Without the Supabase values the site still runs: orders are kept in this
# browser and the built-in catalogue in src/data/products.js is shown.
# Without FeedFusion the "Seen on Instagram" gallery uses the boutique's own
# photography. Nothing crashes when a key is missing.
# ---------------------------------------------------------------------------

# FeedFusion feed endpoint that returns the @fariifeet posts as JSON
VITE_FEEDFUSION_URL=

# FeedFusion API key. Sent as ?key=… unless your URL already carries a key.
VITE_FEEDFUSION_KEY=

# ---------------------------------------------------------------------------
# Supabase — the live catalogue and the order desk
#
# Fill these in after running the SQL (see supabase/README.md):
#   1. supabase_products_setup.sql  products table + 21 seed rows + RLS + Realtime
#   2. supabase/schema.sql          orders
#   3. supabase/instagram-sync.sql  optional: import columns + product-images bucket
#
# Two names are accepted for the browser key — the new Supabase name first:
#   VITE_SUPABASE_PUBLISHABLE_KEY   "Publishable key" (sb_publishable_…) under
#                                   Dashboard -> Project Settings -> API keys
#   VITE_SUPABASE_ANON_KEY          legacy "anon public" JWT, still valid
# src/lib/config.js reads whichever is set and exposes it as SUPABASE_KEY.
#
# These keys are public: Vite inlines them into the bundle. RLS protects the
# data. NEVER put `sb_secret_…` or the service_role key in a VITE_ variable —
# config.js refuses to use one if you do.
# ---------------------------------------------------------------------------

# Project URL, e.g. https://bcgstfeotcuytnoxctoc.supabase.co
VITE_SUPABASE_URL=

# Publishable key (sb_publishable_…) — or the legacy anon key instead
VITE_SUPABASE_PUBLISHABLE_KEY=
# VITE_SUPABASE_ANON_KEY=

# PIN for the hidden order desk at /admin. Change it before going live.
VITE_ADMIN_PIN=1234

# ---------------------------------------------------------------------------
# WhatsApp order line (optional)
#
# Digits only, international format. Leave empty to use the shop line that is
# built into src/lib/store.js (255754623904).
# ---------------------------------------------------------------------------
VITE_WHATSAPP_NUMBER=

# ---------------------------------------------------------------------------
# Instagram -> catalogue importer (SERVER ONLY — never prefix these with VITE_)
#
# Read by the Netlify functions in netlify/functions/ and by
# `npm run instagram:sync` on this machine. Vite never inlines them, so they
# cannot leak into the browser bundle. Put the same values in Netlify ->
# Site configuration -> Environment variables (scope: Functions).
# See README -> "Instagram -> catalogue".
# ---------------------------------------------------------------------------

# Supabase project URL + service_role key.
# (Dashboard -> Project Settings -> API keys -> service_role / secret key).
# The service role key bypasses RLS so photos can be uploaded and products
# added. SUPABASE_URL may be left empty — the functions fall back to
# VITE_SUPABASE_URL, which points at the same project.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Instagram Graph API long-lived access token, and the account to read
#   graph.instagram.com  -> INSTAGRAM_USER_ID=me   (Instagram API with Instagram Login)
#   graph.facebook.com   -> Instagram Business account id + a Page token
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=
INSTAGRAM_GRAPH_BASE=

# Shared secret required by POST /api/instagram-sync. Leave empty and the HTTP
# endpoint stays closed — the daily schedule still imports posts.
# Generate one with: openssl rand -hex 24
INSTAGRAM_SYNC_SECRET=

# Optional tuning (defaults shown)
# INSTAGRAM_SYNC_LIMIT=6          # posts inspected per run, 1-10
# INSTAGRAM_AUTO_PUBLISH=true     # false = import hidden drafts for review
# INSTAGRAM_STORAGE_BUCKET=product-images

