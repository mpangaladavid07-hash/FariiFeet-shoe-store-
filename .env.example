# ---------------------------------------------------------------------------
# FariiFeet — Stage 1 environment variables
#
# Copy this file to `.env.local` (git-ignored) and fill in your FeedFusion keys.
# The "Seen on Instagram" gallery reads these at build/dev time (Vite only
# exposes variables prefixed with VITE_). Without them the gallery falls back
# to the boutique's own real photography — nothing breaks.
# ---------------------------------------------------------------------------

# FeedFusion feed endpoint that returns the @fariifeet posts as JSON
VITE_FEEDFUSION_URL=

# FeedFusion API key. Sent as ?key=… unless your URL already carries a key.
VITE_FEEDFUSION_KEY=

# ---------------------------------------------------------------------------
# Supabase (optional — leave empty to keep orders in this browser and serve
# the built-in catalogue from src/data/products.js)
#
# Fill these in after running `supabase/schema.sql`, `supabase/products.sql`
# and `supabase/seed-products.sql`. The anon key is read-only: products are
# edited from the Supabase dashboard, never from the browser.
# ---------------------------------------------------------------------------

# Project URL, e.g. https://abcdefghijklm.supabase.co
VITE_SUPABASE_URL=

# Public anon key (Dashboard -> Project Settings -> API -> anon public)
VITE_SUPABASE_ANON_KEY=

# PIN for the hidden order desk at /admin. Change it before going live.
VITE_ADMIN_PIN=1234

# ---------------------------------------------------------------------------
# WhatsApp order line (optional)
#
# Digits only, international format. Leave empty to use the shop line that is
# built into src/lib/store.js (255754623904).
# ---------------------------------------------------------------------------
VITE_WHATSAPP_NUMBER=

# ---------------------------------------------------------------------------
# Instagram -> catalogue importer (SERVER ONLY — never prefix these with VITE_)
#
# Read by the Netlify functions in netlify/functions/ and by
# `npm run instagram:sync` on this machine. Vite never inlines them, so they
# cannot leak into the browser bundle. Put the same values in Netlify ->
# Site configuration -> Environment variables (scope: Functions).
# See README -> "Instagram -> catalogue".
# ---------------------------------------------------------------------------

# Supabase project URL + service_role key
# (Dashboard -> Project Settings -> API -> Project API keys -> service_role).
# The service role key bypasses RLS so photos can be uploaded and products added.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Instagram Graph API long-lived access token, and the account to read
#   graph.instagram.com  -> INSTAGRAM_USER_ID=me   (Instagram API with Instagram Login)
#   graph.facebook.com   -> Instagram Business account id + a Page token
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=
INSTAGRAM_GRAPH_BASE=

# Shared secret required by POST /api/instagram-sync. Leave empty and the HTTP
# endpoint stays closed — the daily schedule still imports posts.
# Generate one with: openssl rand -hex 24
INSTAGRAM_SYNC_SECRET=

# Optional tuning (defaults shown)
# INSTAGRAM_SYNC_LIMIT=6          # posts inspected per run, 1-10
# INSTAGRAM_AUTO_PUBLISH=true     # false = import hidden drafts for review
# INSTAGRAM_STORAGE_BUCKET=product-images

